#!/bin/bash

# Start fetch_quota.py in background if not running
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -f "$SCRIPT_DIR/fetch_quota.py" ]; then
    FETCH_QUOTA_PATH="$SCRIPT_DIR/fetch_quota.py"
elif [ -f "/usr/share/vlfstatus/fetch_quota.py" ]; then
    FETCH_QUOTA_PATH="/usr/share/vlfstatus/fetch_quota.py"
else
    FETCH_QUOTA_PATH="/home/v/Projects/vlfstatus/fetch_quota.py"
fi

pgrep -f "python3 $FETCH_QUOTA_PATH" >/dev/null || python3 "$FETCH_QUOTA_PATH" >/dev/null 2>&1 &

echo "{ \"version\": 1 }"
echo "["
echo "[]"

LAST_QUOTA_MTIME=""
LAST_NUM_ACCOUNTS=0
LAST_UPDATED=""

while true; do
	source ~/.cache/bar_colors.sh 2>/dev/null || { 
		COLOR_WIFI="#FF0055"
		COLOR_BAT_HIGH="#FF0055"
		COLOR_BAT_MID="#FF0055"
		COLOR_BAT_LOW="#FF0055"
		COLOR_TIME="#FF0055"
		COLOR_TEXT="#FFFFFF"
		COLOR_SEP="#0DCDCD"
	}
	source ~/.config/vlfstatus/config 2>/dev/null

	# ⚡ Bolt Optimization: Use bash built-ins for date formatting and reading files.
	# Avoids expensive fork/exec of `date` and `cat` subprocesses every second.
	printf -v DATETIME "%(%d %a %H:%M:%S)T" -1
	# ⚡ Bolt Optimization: Use CLI-native formatting flag to avoid grep/sed fork/exec overhead
	WIFI_RAW=$(nmcli -t -f GENERAL.CONNECTION dev show wlp8s0 2>/dev/null)
	if [[ "$WIFI_RAW" == "--" || -z "$WIFI_RAW" ]]; then
		WIFI_ICON="󰤮 "
		WIFI_TEXT="Not connected"
	else
		WIFI_ICON="󰖩 "
		WIFI_TEXT="$WIFI_RAW"
		# SECURITY: Sanitize WIFI_TEXT to prevent JSON and Pango injection.
		# Specifically strip control characters which could break JSON output and crash the window manager.
		# Handle bash 5.2+ patsub_replacement if enabled
		shopt -u patsub_replacement 2>/dev/null || true
		WIFI_TEXT="${WIFI_TEXT//[[:cntrl:]]/}"
		WIFI_TEXT="${WIFI_TEXT//\\/\\\\}"
		WIFI_TEXT="${WIFI_TEXT//&/&amp;}"
		WIFI_TEXT="${WIFI_TEXT//</&lt;}"
		WIFI_TEXT="${WIFI_TEXT//>/&gt;}"
		WIFI_TEXT="${WIFI_TEXT//\"/\\\"}"
	fi
	
	read -r CAP 2>/dev/null < /sys/class/power_supply/BAT0/capacity || CAP=100
	read -r BAT_STATUS 2>/dev/null < /sys/class/power_supply/BAT0/status || BAT_STATUS="Unknown"
	if [[ "$BAT_STATUS" == "Charging" || "$BAT_STATUS" == "Full" || "$BAT_STATUS" == "Not charging" ]]; then
		if [[ $CAP -gt 95 ]]; then
			CAP_ICON="󰂅 "
		elif [[ $CAP -gt 90 ]]; then
			CAP_ICON="󰂋 "
		elif [[ $CAP -gt 80 ]]; then
			CAP_ICON="󰂊 "
		elif [[ $CAP -gt 70 ]]; then
			CAP_ICON="󰢞 "
		elif [[ $CAP -gt 60 ]]; then
			CAP_ICON="󰂉 "
		elif [[ $CAP -gt 50 ]]; then
			CAP_ICON="󰢝 "
		elif [[ $CAP -gt 40 ]]; then
			CAP_ICON="󰂈 "
		elif [[ $CAP -gt 30 ]]; then
			CAP_ICON="󰂇 "
		elif [[ $CAP -gt 20 ]]; then
			CAP_ICON="󰂆 "
		else
			CAP_ICON="󰢜 "
		fi
		COLOR_BAT=$COLOR_BAT_HIGH
	elif [[ $CAP -gt 74 ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_HIGH
	elif [[ $CAP -gt 49 ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_HIGH
	elif [[ $CAP -gt 24 ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_MID
	elif [[ $CAP -gt 10 ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_LOW
	else
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_LOW
	fi

	QUOTA_TEXT=""
	if command -v agy >/dev/null 2>&1 && [ -f ~/.cache/agy_quota.json ]; then
		# ⚡ Bolt Optimization: Cache JSON parsing by tracking file mtime.
		# Avoids executing 9 expensive `grep` subprocesses every second.
		CURRENT_QUOTA_MTIME=$(stat -c %Y ~/.cache/agy_quota.json 2>/dev/null)
		if [ "$CURRENT_QUOTA_MTIME" != "$LAST_QUOTA_MTIME" ]; then
			LAST_QUOTA_MTIME=$CURRENT_QUOTA_MTIME

			G_5H_ARR=($(grep -oP '"gemini_5h": "\K[0-9.]+' ~/.cache/agy_quota.json))
			G_WK_ARR=($(grep -oP '"gemini_weekly": "\K[0-9.]+' ~/.cache/agy_quota.json))
			C_5H_ARR=($(grep -oP '"claude_5h": "\K[0-9.]+' ~/.cache/agy_quota.json))
			C_WK_ARR=($(grep -oP '"claude_weekly": "\K[0-9.]+' ~/.cache/agy_quota.json))

			G_5H_EPOCH_ARR=($(grep -oP '"gemini_5h_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json))
			G_WK_EPOCH_ARR=($(grep -oP '"gemini_weekly_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json))
			C_5H_EPOCH_ARR=($(grep -oP '"claude_5h_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json))
			C_WK_EPOCH_ARR=($(grep -oP '"claude_weekly_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json))

			LAST_NUM_ACCOUNTS=${#G_5H_ARR[@]}
			LAST_UPDATED=$(grep -oP '"last_updated_epoch": \K[0-9]+' ~/.cache/agy_quota.json | head -n1)
		fi

		if [ $LAST_NUM_ACCOUNTS -gt 0 ]; then
			NOW=$EPOCHSECONDS
			MULTI_ACCOUNT_MODE=${MULTI_ACCOUNT_MODE:-"combine"}
			
			REFRESH_TXT=""
			if [ -n "$LAST_UPDATED" ]; then
				AGE=$((NOW - LAST_UPDATED))
				AGE_COLOR="$COLOR_SEP"
				if [ $AGE -ge 300 ]; then
					AGE_COLOR="$COLOR_BAT_LOW"
				elif [ $AGE -ge 120 ]; then
					AGE_COLOR="$COLOR_BAT_MID"
				fi

				if [ $AGE -ge 60 ]; then
					AGE_M=$((AGE / 60))
					AGE_S=$((AGE % 60))
					AGE_TXT="${AGE_M}m${AGE_S}s"
				else
					AGE_TXT="${AGE}s"
				fi
				REFRESH_TXT=" <span color='$AGE_COLOR'>⟳ ${AGE_TXT}</span>"
			fi
			
			function format_reset_time() {
				local SEC=$1
				if [ $SEC -le 0 ]; then
					echo "0s"
				else
					local H=$((SEC / 3600))
					local M=$(((SEC % 3600) / 60))
					local S=$((SEC % 60))
					if [ $H -gt 0 ]; then
						if [ $H -gt 24 ]; then
							local D=$((H / 24))
							H=$((H % 24))
							echo "${D}d${H}h"
						else
							echo "${H}h${M}m"
						fi
					else
						echo "${M}m${S}s"
					fi
				fi
			}

			if [ "$MULTI_ACCOUNT_MODE" = "separate" ]; then
				for ((i=0; i<$LAST_NUM_ACCOUNTS; i++)); do
					G_5H="${G_5H_ARR[$i]}"
					G_WK="${G_WK_ARR[$i]}"
					C_5H="${C_5H_ARR[$i]}"
					C_WK="${C_WK_ARR[$i]}"

					G5H="${G_5H:-$G_WK}"
					G_EPOCH="${G_5H_EPOCH_ARR[$i]:-${G_WK_EPOCH_ARR[$i]}}"

					C5H="${C_5H:-$C_WK}"
					C_EPOCH="${C_5H_EPOCH_ARR[$i]:-${C_WK_EPOCH_ARR[$i]}}"

					G_RESET="N/A"
					if [ -n "$G_EPOCH" ] && [ "$G_EPOCH" -gt 0 ]; then
						G_RESET=$(format_reset_time $((G_EPOCH - NOW)))
					fi

					C_RESET="N/A"
					if [ -n "$C_EPOCH" ] && [ "$C_EPOCH" -gt 0 ]; then
						C_RESET=$(format_reset_time $((C_EPOCH - NOW)))
					fi

					# Build string per account
					QUOTA_TEXT="$QUOTA_TEXT <span color='$COLOR_WIFI'> </span><span color='$COLOR_TEXT'>${G5H}%</span><span color='$COLOR_SEP'> ${G_RESET}</span> <span color='$COLOR_WIFI'> </span><span color='$COLOR_TEXT'>${C5H}%</span><span color='$COLOR_SEP'> ${C_RESET}</span>"
				done
				QUOTA_TEXT="$QUOTA_TEXT${REFRESH_TXT}"
			else
				# Combined mode
				# ⚡ Bolt Optimization: Batch awk floating-point math evaluation outside the loop to avoid multiple expensive fork/exec calls per account.
				TOTAL_G_EXPR="0"
				TOTAL_C_EXPR="0"
				MIN_G_EPOCH=99999999999
				MIN_C_EPOCH=99999999999

				for ((i=0; i<$LAST_NUM_ACCOUNTS; i++)); do
					G_5H="${G_5H_ARR[$i]}"
					G_WK="${G_WK_ARR[$i]}"
					C_5H="${C_5H_ARR[$i]}"
					C_WK="${C_WK_ARR[$i]}"

					G5H="${G_5H:-$G_WK}"
					G_EPOCH="${G_5H_EPOCH_ARR[$i]:-${G_WK_EPOCH_ARR[$i]}}"

					C5H="${C_5H:-$C_WK}"
					C_EPOCH="${C_5H_EPOCH_ARR[$i]:-${C_WK_EPOCH_ARR[$i]}}"

					TOTAL_G_EXPR="$TOTAL_G_EXPR + ${G5H:-0}"
					TOTAL_C_EXPR="$TOTAL_C_EXPR + ${C5H:-0}"

					# Only consider epochs > 0
					if [ -n "$G_EPOCH" ] && [ "$G_EPOCH" -gt 0 ] && [ "$G_EPOCH" -lt "$MIN_G_EPOCH" ]; then
						MIN_G_EPOCH=$G_EPOCH
					fi
					if [ -n "$C_EPOCH" ] && [ "$C_EPOCH" -gt 0 ] && [ "$C_EPOCH" -lt "$MIN_C_EPOCH" ]; then
						MIN_C_EPOCH=$C_EPOCH
					fi
				done
				read -r TOTAL_G TOTAL_C <<< $(awk "BEGIN {print $AWK_G_EXPR, $AWK_C_EXPR}")

				TOTAL_G=$(awk "BEGIN {val=($TOTAL_G_EXPR)/$LAST_NUM_ACCOUNTS; if (val == int(val)) printf \"%d\", val; else printf \"%.1f\", val}")
				TOTAL_C=$(awk "BEGIN {val=($TOTAL_C_EXPR)/$LAST_NUM_ACCOUNTS; if (val == int(val)) printf \"%d\", val; else printf \"%.1f\", val}")

				G_RESET="N/A"
				if [ "$MIN_G_EPOCH" -ne 99999999999 ]; then
					G_RESET=$(format_reset_time $((MIN_G_EPOCH - NOW)))
				fi

				C_RESET="N/A"
				if [ "$MIN_C_EPOCH" -ne 99999999999 ]; then
					C_RESET=$(format_reset_time $((MIN_C_EPOCH - NOW)))
				fi

				QUOTA_TEXT=" <span color='$COLOR_WIFI'> </span><span color='$COLOR_TEXT'>${TOTAL_G}%</span><span color='$COLOR_SEP'> ${G_RESET}</span> <span color='$COLOR_WIFI'> </span><span color='$COLOR_TEXT'>${TOTAL_C}%</span><span color='$COLOR_SEP'> ${C_RESET}</span>${REFRESH_TXT}"
			fi
		fi
	fi
	
	# Retrieve Volume Status
	VOL_INDICATOR=""
	# ⚡ Bolt Optimization: Replace awk/grep/head external pipelines with bash native regex matching to eliminate subshell forks
	PACTL_MUTE_OUT=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null)
	[[ "$PACTL_MUTE_OUT" =~ (yes|no) ]] && MUTE_STATUS="${BASH_REMATCH[1]}" || MUTE_STATUS=""

	PACTL_VOL_OUT=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null)
	[[ "$PACTL_VOL_OUT" =~ ([0-9]+)% ]] && VOL_RAW="${BASH_REMATCH[1]}" || VOL_RAW=""

	if [ -n "$VOL_RAW" ]; then
		if [ "$MUTE_STATUS" = "yes" ]; then
			VOL_INDICATOR=" <span color='$COLOR_BAT_LOW'>󰝟 </span><span color='$COLOR_TEXT'>muted (${VOL_RAW}%)</span>"
		elif [ "$VOL_RAW" -eq 0 ]; then
			VOL_INDICATOR=" <span color='$COLOR_BAT_LOW'>󰝟 </span><span color='$COLOR_TEXT'>0%</span>"
		else
			if [ "$VOL_RAW" -gt 66 ]; then
				VOL_ICON=" "
			elif [ "$VOL_RAW" -gt 33 ]; then
				VOL_ICON=" "
			else
				VOL_ICON=" "
			fi
			VOL_INDICATOR=" <span color='$COLOR_TIME'>${VOL_ICON}</span><span color='$COLOR_TEXT'>${VOL_RAW}%</span>"
		fi
	fi

	# Active App Indicators
	APP_INDICATORS=""
	if systemctl --user is-active --quiet jules-listener.service 2>/dev/null; then
		APP_INDICATORS="$APP_INDICATORS <span color='#FFD700'>󱚝</span>"
	fi
	if pgrep -f gitkraken >/dev/null 2>&1; then
		APP_INDICATORS="$APP_INDICATORS <span color='#179287'></span>"
	fi
	if pgrep -x dockerd >/dev/null 2>&1; then
		APP_INDICATORS="$APP_INDICATORS <span color='#2496ed'>󰡨</span>"
	fi

	# Build BAR with Quota on the leftmost side (swapped with WiFi)
	BAR=" <span color='$COLOR_SEP'>//</span>"
	if [ -n "$QUOTA_TEXT" ]; then
		BAR="$BAR$QUOTA_TEXT <span color='$COLOR_SEP'>//</span>"
	fi
	BAR="$BAR <span color='$COLOR_WIFI'>$WIFI_ICON</span><span color='$COLOR_TEXT'>$WIFI_TEXT</span>"
	if [ -n "$VOL_INDICATOR" ]; then
		BAR="$BAR <span color='$COLOR_SEP'>//</span>$VOL_INDICATOR"
	fi
	BAR="$BAR <span color='$COLOR_SEP'>//</span> <span color='$COLOR_BAT'>$CAP_ICON</span><span color='$COLOR_TEXT'>${CAP}%</span>"
	if [ -n "$APP_INDICATORS" ]; then
		BAR="$BAR <span color='$COLOR_SEP'>//</span>$APP_INDICATORS"
	fi
	BAR="$BAR <span color='$COLOR_SEP'>//</span> <span color='$COLOR_TIME'>󰃰 </span><span color='$COLOR_TEXT'>$DATETIME</span> "
	
	echo ",[{\"full_text\": \"$BAR\", \"markup\": \"pango\"}]"
	
	sleep 1
done

