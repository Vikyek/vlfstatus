#!/bin/bash

# Start fetch_quota.py in background if not running
pgrep -f "python3 /home/v/Projects/vlfstatus/fetch_quota.py" >/dev/null || python3 /home/v/Projects/vlfstatus/fetch_quota.py >/dev/null 2>&1 &

echo "{ \"version\": 1 }"
echo "["
echo "[]"

while true; do
	source ~/.cache/bar_colors.sh 2>/dev/null || { 
		COLOR_WIFI="#FF0055"
		COLOR_BAT_HIGH="#FF0055"
		COLOR_BAT_MID="#FF0055"
		COLOR_BAT_LOW="#FF0055"
		COLOR_TIME="#FF0055"
		COLOR_TEXT="#FFFFFF"
		COLOR_SEP="#0DCDCD"
	}

	DATETIME=$(date +"%d %a %H:%M:%S")
	WIFI_RAW=$(nmcli dev show wlp8s0 2>/dev/null | grep "GENERAL.CONNECTION" | sed -e "s/^GENERAL.CONNECTION:[ \t]*//")
	if [[ "$WIFI_RAW" == "--" || -z "$WIFI_RAW" ]]; then
		WIFI_ICON="󰤮 "
		WIFI_TEXT="Not connected"
	else
		WIFI_ICON="󰖩 "
		WIFI_TEXT="$WIFI_RAW"
	fi
	
	CAP=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 100)
	if [[ ((CAP -gt 74)) ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_HIGH
	elif [[ ((CAP -gt 49)) ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_HIGH
	elif [[ ((CAP -gt 24)) ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_MID
	elif [[ ((CAP -gt 10)) ]]; then
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_LOW
	else
		CAP_ICON=" "
		COLOR_BAT=$COLOR_BAT_LOW
	fi

	QUOTA_TEXT=""
	if [ -f ~/.cache/agy_quota.json ]; then
		G_5H=$(grep -oP '"gemini_5h": "\K[0-9.]+' ~/.cache/agy_quota.json)
		G_WK=$(grep -oP '"gemini_weekly": "\K[0-9.]+' ~/.cache/agy_quota.json)
		C_5H=$(grep -oP '"claude_5h": "\K[0-9.]+' ~/.cache/agy_quota.json)
		C_WK=$(grep -oP '"claude_weekly": "\K[0-9.]+' ~/.cache/agy_quota.json)
		
		if [ -n "$G_5H" ] && [ -n "$G_WK" ] && [ -n "$C_5H" ] && [ -n "$C_WK" ]; then
			NOW=$(date +%s)
			G_RESET="N/A"
			C_RESET="N/A"
			
			# Decide limiting Gemini quota
			G_5H_INT=${G_5H%.*}
			G_WK_INT=${G_WK%.*}
			if [ "$G_WK_INT" -le "$G_5H_INT" ]; then
				G5H="$G_WK"
				G_EPOCH=$(grep -oP '"gemini_weekly_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json)
			else
				G5H="$G_5H"
				G_EPOCH=$(grep -oP '"gemini_5h_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json)
			fi
			
			# Decide limiting Claude quota
			C_5H_INT=${C_5H%.*}
			C_WK_INT=${C_WK%.*}
			if [ "$C_WK_INT" -le "$C_5H_INT" ]; then
				C5H="$C_WK"
				C_EPOCH=$(grep -oP '"claude_weekly_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json)
			else
				C5H="$C_5H"
				C_EPOCH=$(grep -oP '"claude_5h_reset_epoch": \K[0-9]+' ~/.cache/agy_quota.json)
			fi

			if [ -n "$G_EPOCH" ] && [ "$G_EPOCH" -gt 0 ]; then
				G_SEC=$((G_EPOCH - NOW))
				if [ $G_SEC -le 0 ]; then
					G_RESET="0s"
				else
					H=$((G_SEC / 3600))
					M=$(((G_SEC % 3600) / 60))
					S=$((G_SEC % 60))
					if [ $H -gt 0 ]; then
						# If weekly resets in days, format nicely
						if [ $H -gt 24 ]; then
							D=$((H / 24))
							H=$((H % 24))
							G_RESET="${D}d${H}h"
						else
							G_RESET="${H}h${M}m"
						fi
					else
						G_RESET="${M}m${S}s"
					fi
				fi
			fi

			if [ -n "$C_EPOCH" ] && [ "$C_EPOCH" -gt 0 ]; then
				C_SEC=$((C_EPOCH - NOW))
				if [ $C_SEC -le 0 ]; then
					C_RESET="0s"
				else
					H=$((C_SEC / 3600))
					M=$(((C_SEC % 3600) / 60))
					S=$((C_SEC % 60))
					if [ $H -gt 0 ]; then
						if [ $H -gt 24 ]; then
							D=$((H / 24))
							H=$((H % 24))
							C_RESET="${D}d${H}h"
						else
							C_RESET="${H}h${M}m"
						fi
					else
						C_RESET="${M}m${S}s"
					fi
				fi
			fi
			
			LAST_UPDATED=$(grep -oP '"last_updated_epoch": \K[0-9]+' ~/.cache/agy_quota.json)
			REFRESH_TXT=""
			if [ -n "$LAST_UPDATED" ]; then
				AGE=$((NOW - LAST_UPDATED))
				if [ $AGE -ge 60 ]; then
					AGE_M=$((AGE / 60))
					AGE_S=$((AGE % 60))
					AGE_TXT="${AGE_M}m${AGE_S}s"
				else
					AGE_TXT="${AGE}s"
				fi
				REFRESH_TXT=" <span color='$COLOR_SEP'>⟳${AGE_TXT}</span>"
			fi
			
			QUOTA_TEXT=" <span color='$COLOR_WIFI'> </span><span color='$COLOR_TEXT'>${G5H}%</span><span color='$COLOR_SEP'> ${G_RESET}</span> <span color='$COLOR_WIFI'> </span><span color='$COLOR_TEXT'>${C5H}%</span><span color='$COLOR_SEP'> ${C_RESET}</span>${REFRESH_TXT}"
		fi
	fi
	
	# Retrieve Volume Status
	VOL_INDICATOR=""
	MUTE_STATUS=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')
	VOL_RAW=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -Po '[0-9]+(?=%)' | head -n1)
	if [ -n "$VOL_RAW" ]; then
		if [ "$MUTE_STATUS" = "yes" ]; then
			VOL_INDICATOR=" <span color='$COLOR_BAT_LOW'>󰝟 </span><span color='$COLOR_TEXT'>mute</span>"
		else
			VOL_INDICATOR=" <span color='$COLOR_TIME'> </span><span color='$COLOR_TEXT'>${VOL_RAW}%</span>"
		fi
	fi

	# Active App Indicators
	APP_INDICATORS=""
	if pgrep -f bitwarden >/dev/null 2>&1; then
		APP_INDICATORS="$APP_INDICATORS <span color='#3892e0'>󰞵</span>"
	fi
	if pgrep -f gitkraken >/dev/null 2>&1; then
		APP_INDICATORS="$APP_INDICATORS <span color='#179287'></span>"
	fi
	if pgrep -x dockerd >/dev/null 2>&1; then
		APP_INDICATORS="$APP_INDICATORS <span color='#2496ed'>󰡨</span>"
	fi

	# Build BAR with Quota on the leftmost side (swapped with WiFi)
	BAR=" <span color='$COLOR_SEP'>//</span>"
	if [ -n "$QUOTA_TEXT" ]; then
		BAR="$BAR$QUOTA_TEXT <span color='$COLOR_SEP'>//</span>"
	fi
	BAR="$BAR <span color='$COLOR_WIFI'>$WIFI_ICON</span><span color='$COLOR_TEXT'>$WIFI_TEXT</span>"
	if [ -n "$VOL_INDICATOR" ]; then
		BAR="$BAR <span color='$COLOR_SEP'>//</span>$VOL_INDICATOR"
	fi
	BAR="$BAR <span color='$COLOR_SEP'>//</span> <span color='$COLOR_BAT'>$CAP_ICON</span><span color='$COLOR_TEXT'>${CAP}%</span>"
	if [ -n "$APP_INDICATORS" ]; then
		BAR="$BAR <span color='$COLOR_SEP'>//</span>$APP_INDICATORS"
	fi
	BAR="$BAR <span color='$COLOR_SEP'>//</span> <span color='$COLOR_TIME'>󰃰 </span><span color='$COLOR_TEXT'>$DATETIME</span> "
	
	echo ",[{\"full_text\": \"$BAR\", \"markup\": \"pango\"}]"
	
	sleep 1
done

